{
  "name": "ai-delivery-control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --sort --if-present build",
    "bootstrap:admin": "pnpm --filter @delivery/api bootstrap:admin",
    "benchmark:admin-users": "pnpm --filter @delivery/api benchmark:admin-users",
    "benchmark:review-acceptance": "pnpm --filter @delivery/api benchmark:review-acceptance",
    "check:architecture": "depcruise --config dependency-cruiser.cjs apps packages",
    "check:dead-code": "knip",
    "check:duplication": "jscpd apps packages",
    "dev": "pnpm infra:up && pnpm --parallel --filter @delivery/api --filter @delivery/web --filter @delivery/worker --filter @delivery/sandbox-runner dev",
    "dev:api": "pnpm --filter @delivery/api dev",
    "dev:sandbox": "pnpm --filter @delivery/sandbox-runner dev",
    "dev:web": "pnpm --filter @delivery/web dev",
    "dev:worker": "pnpm --filter @delivery/worker dev",
    "drill:worker-reliability": "RELIABILITY_RABBIT_CONTAINER=delivery-control-plane-rabbitmq-1 pnpm --filter @delivery/worker drill:reliability",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:down": "docker compose --env-file .env -f infra/compose/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/compose/docker-compose.yml logs -f",
    "infra:ps": "docker compose --env-file .env -f infra/compose/docker-compose.yml ps",
    "infra:up": "docker compose --env-file .env -f infra/compose/docker-compose.yml up -d --wait postgres rabbitmq minio jaeger otel-collector && docker compose --env-file .env -f infra/compose/docker-compose.yml run --rm minio-init",
    "db:migrate": "pnpm --filter @delivery/database migrate up",
    "lint": "eslint . --max-warnings 0",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm check:architecture && pnpm check:dead-code && pnpm check:duplication && pnpm build",
    "start:api": "pnpm --filter @delivery/api start",
    "start:sandbox": "pnpm --filter @delivery/sandbox-runner start",
    "start:worker": "pnpm --filter @delivery/worker start",
    "test": "vitest run --coverage",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts --passWithNoTests",
    "typecheck": "pnpm -r --sort --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.3.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "jscpd": "5.0.16",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1"
  }
}
