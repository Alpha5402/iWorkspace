{
  "name": "@delivery/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark:capacity": "NODE_OPTIONS=--conditions=development tsx --env-file=../../.env src/cli/reviewCapacityBenchmark.ts",
    "build": "tsup src/main.ts --format esm --sourcemap --clean",
    "dev": "NODE_OPTIONS=--conditions=development tsx watch --env-file=../../.env src/main.ts",
    "drill:reliability": "NODE_OPTIONS=--conditions=development tsx --env-file=../../.env src/cli/reliabilityDrill.ts",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@delivery/contracts": "workspace:*",
    "@delivery/database": "workspace:*",
    "@delivery/domain": "workspace:*",
    "@delivery/health": "workspace:*",
    "@delivery/messaging": "workspace:*",
    "@delivery/observability": "workspace:*",
    "@delivery/object-storage": "workspace:*",
    "@delivery/providers-agent": "workspace:*",
    "@delivery/providers-email": "workspace:*",
    "@delivery/providers-github": "workspace:*",
    "@delivery/security": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@delivery/testkit": "workspace:*"
  }
}
