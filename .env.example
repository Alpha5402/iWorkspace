# Copy this file to .env for local development. Never commit real credentials.
NODE_ENV=development
LOG_LEVEL=info

API_HOST=127.0.0.1
API_PORT=3000
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3001
SANDBOX_HEALTH_HOST=127.0.0.1
SANDBOX_HEALTH_PORT=3002
WEB_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:3000/api/v1

POSTGRES_DB=delivery_control_plane
POSTGRES_USER=delivery
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://delivery:local-development-only@127.0.0.1:5432/delivery_control_plane

RABBITMQ_DEFAULT_USER=delivery
RABBITMQ_DEFAULT_PASS=local-development-only
RABBITMQ_URL=amqp://delivery:local-development-only@127.0.0.1:5672

MINIO_ROOT_USER=delivery
MINIO_ROOT_PASSWORD=local-development-only-change-me
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=delivery-artifacts
S3_ACCESS_KEY=delivery
S3_SECRET_KEY=local-development-only-change-me

OTEL_SERVICE_NAME=delivery-control-plane
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Enable only when Docker Compose infrastructure is running.
RUN_INFRA_INTEGRATION=false
